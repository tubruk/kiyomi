{
  "name": "kiyomi",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight API-first manga reader and source aggregator platform powered by Go and React",
  "scripts": {
    "dev:plugins": "KIYOMI_PLUGIN_DIR=dev-plugins go run ./scripts/watch-plugins.go",
    "dev:api": "KIYOMI_PLUGIN_DIR=dev-plugins go run ./cmd/kiyomi",
    "dev:ui": "bun --cwd web dev",
    "dev": "concurrently -n \"PLUGINS,API,UI\" -c \"yellow.bold,magenta.bold,cyan.bold\" \"bun dev:plugins\" \"bun dev:api\" \"bun dev:ui\"",
    "build:ui": "bun --cwd web build",
    "build:api": "go build -o bin/kiyomi ./cmd/kiyomi",
    "build": "bun run build:ui && bun run build:api",
    "test": "go test -v ./...",
    "e2e": "bash e2e/run.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
